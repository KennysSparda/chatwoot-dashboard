# Credenciais do Chatwoot — NUNCA prefixar com NEXT_PUBLIC_ (isso exporia pro navegador).
# Configure estas 3 na Vercel em Project Settings > Environment Variables.
CHATWOOT_BASE_URL=https://app.chatwoot.com
CHATWOOT_ACCOUNT_ID=99999
CHATWOOT_ACCESS_TOKEN=seu_token_de_administrador_aqui

# Senha simples pra proteger o painel (qualquer um com a URL da Vercel + essa senha entra).
# Troque por algo forte antes de subir.
DASHBOARD_PASSWORD=troque_isso_antes_de_subir
